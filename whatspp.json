      "position": [
        416,
        -128
      ]
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        320,
        80
      ],
      "id": "e6a2c0a1-df58-4f68-9062-57b6bdde1d8f",
      "name": "Groq Chat Model"
    },
    {
      "parameters": {
        "operation": "send",
